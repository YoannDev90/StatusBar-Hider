<?xml version="1.0" encoding="utf-8" ?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Status bar. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,45 h40 a8,8 0 0 1 0,16 h-40 a8,8 0 0 1 0,-16 z" />

    <!-- Cut. Painted in the background colour, so it only shows where it
         crosses the bar and stays invisible over the background itself. -->
