        android:strokeColor="@color/ic_launcher_background"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:pathData="M32,75 L75,32" />

    <!-- Slash. -->
    <path
        android:strokeColor="#4C8DFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M32,75 L75,32" />
</vector>
