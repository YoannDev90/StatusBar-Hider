<?xml version="1.0" encoding="utf-8"?>
<!-- Custom status bar overlay. TextClock handles seconds efficiently (system tick),
     other widgets are updated event-driven from StatusBarOverlayService.
     Children are reordered at runtime from OverlayPrefs.widgetOrder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp"
    android:background="#CC000000">

    <TextClock
        android:id="@+id/clockView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:fontFeatureSettings="tnum"
        android:format12Hour="hh:mm:ss a"
        android:format24Hour="HH:mm:ss" />

    <TextView
        android:id="@+id/dateView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:paddingStart="6dp" />

    <LinearLayout
        android:id="@+id/notifRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingStart="4dp" />

    <Space
        android:id="@+id/spacerView"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bandwidthRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/bandwidthIconDown"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_arrow_down"
            android:contentDescription="Download" />

        <ImageView
            android:id="@+id/bandwidthIconUp"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_arrow_up"
            android:contentDescription="Upload" />

        <ImageView
            android:id="@+id/bandwidthIconMerged"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_swap"
            android:visibility="gone"
            android:contentDescription="Bandwidth" />

        <TextView
            android:id="@+id/bandwidthView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:paddingStart="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/alarmRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/alarmIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_alarm"
            android:contentDescription="Next alarm" />

        <TextView
            android:id="@+id/alarmView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:paddingStart="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/connectivityRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/iconAirplane"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_plane"
            android:visibility="gone"
            android:contentDescription="Airplane mode" />

        <ImageView
            android:id="@+id/iconWifi"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_wifi"
            android:visibility="gone"
            android:contentDescription="WiFi" />

        <ImageView
            android:id="@+id/iconMobile"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_signal"
            android:visibility="gone"
            android:contentDescription="Mobile data" />

        <TextView
            android:id="@+id/mobileTypeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:paddingStart="1dp"
            android:paddingEnd="2dp" />

        <ImageView
            android:id="@+id/iconBluetooth"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_bt"
            android:visibility="gone"
            android:contentDescription="Bluetooth" />

        <ImageView
            android:id="@+id/iconVpn"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_vpn"
            android:visibility="gone"
            android:contentDescription="VPN" />

        <ImageView
            android:id="@+id/iconHotspot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_hotspot"
            android:visibility="gone"
            android:contentDescription="Hotspot" />

        <ImageView
            android:id="@+id/iconUsb"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_usb"
            android:visibility="gone"
            android:contentDescription="USB" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/batteryRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <dev.yoanndev90.statusbarhider.overlay.BatteryView
            android:id="@+id/batteryIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/batteryView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:fontFeatureSettings="tnum"
            android:paddingStart="3dp" />
    </LinearLayout>

</LinearLayout>
