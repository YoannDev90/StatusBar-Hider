<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StatusBar Hider"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1a1a1a"
            android:gravity="center"
            android:paddingBottom="4dp" />

        <!-- OEM name -->
        <TextView
            android:id="@+id/oemNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/statusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#444444"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:background="#f0f0f0" />

        <!-- Section: Shizuku -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SHIZUKU"
            android:textSize="11sp"
            android:textColor="#999999"
            android:letterSpacing="0.12"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btnAuthorizeShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Authorize Shizuku"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <!-- Section: Status bar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="STATUS BAR"
            android:textSize="11sp"
            android:textColor="#999999"
            android:letterSpacing="0.12"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btnHideStatusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide status bar"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnCheckState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check state"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnRestore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restore (undo)"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <!-- Section: App -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="APP"
            android:textSize="11sp"
            android:textColor="#999999"
            android:letterSpacing="0.12"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btnHideFromLauncher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide from launcher"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnExportLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export logs"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <!-- Section: Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="LOG"
            android:textSize="11sp"
            android:textColor="#999999"
            android:letterSpacing="0.12"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:textColor="#333333"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp" />

    </LinearLayout>
</ScrollView>
