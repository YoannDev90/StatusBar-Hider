<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- Migrated to Compose (P3): header, Shizuku and Status bar sections. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Migrated to Compose (P3-C2): custom bar toggles. -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="WIDGET ORDER"
            android:textSize="11sp"
            android:textColor="#999999"
            android:letterSpacing="0.12"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/orderList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <CheckBox
            android:id="@+id/cbDarkText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dark text (for transparent bar)" />

        <RadioGroup
            android:id="@+id/rgBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbTransparent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Transparent" />

            <RadioButton
                android:id="@+id/rbSemi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Semi" />

            <RadioButton
                android:id="@+id/rbBlack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Black" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvPadStartVal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Padding start: 12dp"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbPadStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="32" />

        <TextView
            android:id="@+id/tvPadTopVal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Padding top: 4dp"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbPadTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="32" />

        <TextView
            android:id="@+id/tvPadEndVal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Padding end: 12dp"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbPadEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="32" />

        <TextView
            android:id="@+id/tvPadBottomVal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Padding bottom: 4dp"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbPadBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="32" />

        <Button
            android:id="@+id/btnShowCustomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show custom bar"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnHideCustomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide custom bar"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <!-- Section: App -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="APP"
            android:textSize="11sp"
            android:textColor="#999999"
            android:letterSpacing="0.12"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btnHideFromLauncher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide from launcher"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnExportLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export logs"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <!-- Section: Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="LOG"
            android:textSize="11sp"
            android:textColor="#999999"
            android:letterSpacing="0.12"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:textColor="#333333"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp" />

    </LinearLayout>
</ScrollView>
