<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Lets ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS show the direct "let
         this app always run in background?" prompt instead of dropping the
         user into the full exemption list to find us in. Normal level, so it
         is granted at install with no dialog. Play policy restricts this
         permission - if the build ever ships on the store, delete it: the
         ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS fallback in
         KeepAliveAccess needs no permission at all. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Legacy install-time Bluetooth permission: Android 12+ no longer
         needs it for BluetoothAdapter state, so it is capped at API 30. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Android 12+: read the connected device list for per-device icons.
         Requested at runtime; without it the bar shows the generic glyph. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Detects the app in front of the overlay (app blacklist). Granted by the
         user in Settings > Special app access > Usage access, never at install. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Launcher apps list (the app blacklist picker); required on API 30+.
         The debug and release installs are separate packages: both are listed
         so each build can detect its sister and reach its settings provider
         (settings import from the other build). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="dev.yoanndev90.statusbarhider" />
        <package android:name="dev.yoanndev90.statusbarhider.debug" />
        <!-- Shizuku version read for Debug > Device info (package visibility). -->
        <package android:name="moe.shizuku.privileged.api" />
        <!-- OEM battery / autostart screens the setup checklist deep-links into
             (see keepAlive in assets/oem/*.json). Android 11+ hides other
             packages from PackageManager unless they are declared here, so a
             candidate component can be reported as absent while its screen
             exists. Keep this list in step with the components field. -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.asus.mobilemanager" />
        <package android:name="com.evenwell.powersaving.g3" />
        <provider android:authorities="dev.yoanndev90.statusbarhider.settingsprovider" />
        <provider android:authorities="dev.yoanndev90.statusbarhider.debug.settingsprovider" />
    </queries>

    <!-- Backup is off: the preferences holding the control-API token are
         excluded from Auto Backup / device-to-device transfer, so the secret
         only leaves the device through the explicit settings export. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/Theme.StatusBarHider">

        <activity
            android:name="dev.yoanndev90.statusbarhider.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required: ShizukuServer delivers its binder to the app through this provider.
             Copied from the official Shizuku API documentation. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Serves this install's settings JSON to the sister build (debug <->
             release). exported=true: the sibling is a separate package signed
             with a different key, so exported="false" and a signature
             permission would both lock it out. SettingsProvider.call only
             answers the sister package, which the system derives from the
             caller's UID and cannot be forged. -->
        <provider
            android:name="dev.yoanndev90.statusbarhider.core.backup.SettingsProvider"
            android:authorities="${applicationId}.settingsprovider"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Shares the on-disk app log (cache/logs). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Re-applies the hide commands after reboot when Shizuku is running.
             Requires "Start on boot" enabled in Shizuku settings.
             On a package update only the custom bar is restarted: the disable
             flags live in SystemUI and survive the update.
             exported="false": the system still delivers BOOT_COMPLETED and
             MY_PACKAGE_REPLACED to a non-exported receiver, and no other app
             needs to force-start this process. -->
        <receiver
            android:name="dev.yoanndev90.statusbarhider.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- External control API for Tasker / `am broadcast`. No intent filter:
             only explicit broadcasts targeting this component are accepted, and
             ControlAuth drops any of them without this install's token. Actions
             documented in docs/control-api.md.
             exported="true" cannot carry android:permission: the whole point is
             that Tasker and `adb shell am broadcast` reach it, and neither can
             hold a custom signature permission. The token is the gate. -->
        <receiver
            android:name="dev.yoanndev90.statusbarhider.control.ControlReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver" />

        <!-- Home screen widget: toggles the custom bar and the system bar. -->
        <receiver
            android:name="dev.yoanndev90.statusbarhider.widget.BarWidgetProvider"
            android:enabled="true"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_bar_info" />
        </receiver>

        <service
            android:name="dev.yoanndev90.statusbarhider.overlay.StatusBarOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Custom status bar overlay replacing the hidden system bar" />
        </service>

        <!-- Lock-screen window: TYPE_ACCESSIBILITY_OVERLAY, above the keyguard. -->
        <service
            android:name="dev.yoanndev90.statusbarhider.overlay.LockScreenOverlayService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/a11y_lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_overlay_accessibility_service" />
        </service>

        <!-- exported="true": NotificationManagerService binds this from
             system_server, a different UID, so a non-exported service is
             silently unreachable — Settings still writes
             enabled_notification_listeners, so the app would report
             "notification access granted" while onListenerConnected never
             fires. BIND_NOTIFICATION_LISTENER_SERVICE (signature) keeps every
             other caller out, same as the a11y and QS tile services above. -->
        <service
            android:name="dev.yoanndev90.statusbarhider.overlay.NotifListenerService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/notif_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Quick Settings: hide / restore the system status bar. The service
             icon doubles as the tile icon. -->
        <service
            android:name="dev.yoanndev90.statusbarhider.tiles.HideRestoreTile"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_tile_hide"
            android:label="@string/action_hide_status_bar"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings: show / hide the custom Compose status bar. -->
        <service
            android:name="dev.yoanndev90.statusbarhider.tiles.CustomBarTile"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_tile_bar"
            android:label="@string/tile_custom_bar"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
